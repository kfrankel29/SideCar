rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function verifiedSchoolEmail() {
      return request.auth.token.email_verified == true ||
        request.auth.token.schoolEmailVerified == true;
    }

    function validProfile(data) {
      return data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 80 &&
        data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 80 &&
        data.displayName is string && data.displayName.size() > 1 && data.displayName.size() <= 161 &&
        data.school is string && data.school.size() > 0 && data.school.size() <= 120 &&
        data.homeBase is string && data.homeBase.size() > 0 && data.homeBase.size() <= 120 &&
        data.major is string && data.major.size() > 0 && data.major.size() <= 120 &&
        data.graduationYear is int && data.graduationYear >= 2026 && data.graduationYear <= 2040 &&
        data.photoUrl is string && data.photoUrl.size() > 0 && data.photoUrl.size() <= 2048 &&
        data.profileComplete == true;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow delete: if owns(uid);
      allow create: if owns(uid) && verifiedSchoolEmail() && validProfile(request.resource.data);
      allow update: if owns(uid) && verifiedSchoolEmail() &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'displayName', 'school', 'homeBase', 'major',
          'graduationYear', 'photoUrl', 'profileComplete', 'primaryRole', 'updatedAt'
        ]) &&
        validProfile(request.resource.data) &&
        (!('primaryRole' in request.resource.data) ||
          request.resource.data.primaryRole in ['rider', 'driver']);
    }

    match /auth_otps/{document=**} {
      allow read, write: if false;
    }

    match /password_reset_sessions/{document=**} {
      allow read, write: if false;
    }

    match /mail/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
