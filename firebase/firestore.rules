rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function verifiedSchoolEmail() {
      return request.auth.token.email_verified == true ||
        request.auth.token.schoolEmailVerified == true;
    }

    function validProfile(data) {
      return data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 80 &&
        data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 80 &&
        data.displayName is string && data.displayName.size() > 1 && data.displayName.size() <= 161 &&
        data.school is string && data.school.size() > 0 && data.school.size() <= 120 &&
        data.age is int && data.age >= 18 && data.age <= 100 &&
        data.gender is string && data.gender.size() > 0 && data.gender.size() <= 40 &&
        data.language is string && data.language.size() > 0 && data.language.size() <= 80 &&
        data.photoUrl is string && data.photoUrl.size() > 0 && data.photoUrl.size() <= 2048 &&
        data.profileComplete == true;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow delete: if owns(uid);
      allow create: if owns(uid) && verifiedSchoolEmail() && validProfile(request.resource.data);
      allow update: if owns(uid) && verifiedSchoolEmail() &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'displayName', 'school', 'age', 'gender',
          'language', 'homeBase', 'major', 'graduationYear', 'photoUrl',
          'profileComplete', 'primaryRole', 'updatedAt'
        ]) &&
        validProfile(request.resource.data) &&
        (!('primaryRole' in request.resource.data) ||
          request.resource.data.primaryRole in ['rider', 'driver']);

      match /verifications/{verificationId} {
        allow read: if owns(uid);
        allow write: if false;
      }

      match /vehicles/{vehicleId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && verifiedSchoolEmail() &&
          vehicleId == 'primary' &&
          request.resource.data.keys().hasOnly([
            'year', 'make', 'model', 'color', 'licensePlate', 'photoUrl',
            'complete', 'updatedAt'
          ]) &&
          request.resource.data.year is int &&
          request.resource.data.year >= 1980 &&
          request.resource.data.year <= 2100 &&
          request.resource.data.make is string &&
          request.resource.data.make.size() > 0 &&
          request.resource.data.make.size() <= 40 &&
          request.resource.data.model is string &&
          request.resource.data.model.size() > 0 &&
          request.resource.data.model.size() <= 40 &&
          request.resource.data.color is string &&
          request.resource.data.color.size() > 0 &&
          request.resource.data.color.size() <= 40 &&
          request.resource.data.licensePlate is string &&
          request.resource.data.licensePlate.size() > 0 &&
          request.resource.data.licensePlate.size() <= 20 &&
          request.resource.data.photoUrl is string &&
          request.resource.data.photoUrl.size() > 0 &&
          request.resource.data.photoUrl.size() <= 2048 &&
          request.resource.data.complete == true;
        allow delete: if owns(uid);
      }

      match /blockedUsers/{blockedUid} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }

    match /safetyReports/{reportId} {
      allow read, write: if false;
    }

    match /rides/{rideId} {
      allow read, write: if false;
    }

    match /auth_otps/{document=**} {
      allow read, write: if false;
    }

    match /password_reset_sessions/{document=**} {
      allow read, write: if false;
    }

    match /mail/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
